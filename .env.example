# Copy to .env.local. Without these the app runs local-only (no accounts).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Reference only, NOT read by Vite: Edge Function secrets, set with `npx supabase secrets set ...`
# (see supabase/functions/digistore-ipn/README.md). Never put these in a VITE_ variable.
# DIGISTORE_IPN_PASSPHRASE=same value as the "SHA512" field of the Digistore24 IPN connection
# DIGISTORE_PRODUCT_MAP={"12345":"all","12346":"debts","12347":"goals","12348":"reports","12349":"lifetime"}
# ALLOW_UNSIGNED_IPN=true   # testing only, and only with an empty passphrase
